{
  "name": "algorhythm",
  "version": "0.1.0",
  "description": "A 3D rhythm game played on a QWERTY keyboard. Music by AI, engine by Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elhijodekojima/algorhythm.git"
  },
  "license": "MIT",
  "dependencies": {
    "howler": "^2.2.4",
    "midi-file": "^1.1.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^20.12.0",
    "@types/three": "^0.164.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
